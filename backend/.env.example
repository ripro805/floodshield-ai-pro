DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_REFRESH_INTERVAL_SECONDS=21600
WEATHER_REFRESH_DISTRICTS=Feni,Dhaka,Chattogram,Sylhet
LLM_API_KEY=your-anthropic-claude-api-key
ANTHROPIC_API_KEY=your-anthropic-claude-api-key
# Model name used by the chatbot agent.  Default is `claude-haiku-4-5` (fast, cheap).
# Pick any current Claude alias from https://docs.anthropic.com/en/docs/about-claude/models
LLM_MODEL=claude-haiku-4-5
# Hard ceiling for the tool-use loop and per-message wall time.
CHATBOT_MAX_ITERATIONS=5
CHATBOT_MAX_DURATION_SECONDS=30
CHATBOT_MAX_TOKENS=1024
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# --- Hybrid Automation & n8n Workflow Integration ---
N8N_ENABLED=true
N8N_WEBHOOK_URL=https://ripro821.app.n8n.cloud/webhook/floodshield-monitoring
AUTOMATION_MODE=auto
N8N_TIMEOUT=15
N8N_HEALTH_CACHE_SECONDS=30
N8N_WEBHOOK_HEADER_NAME=X-N8N-Webhook-Secret
N8N_WEBHOOK_SECRET=replace-with-a-random-secret
FLOODSHIELD_BACKEND_BASE_URL=https://your-backend-api.example.com
# Optional Hugging Face Inference Endpoint for chatbot text generation only.
# The local flood/disease models remain the .pkl/.keras artifacts in models/.
HF_INFERENCE_API_URL=
GEE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# --- Reference-data seeding ---
# The backend seeds locations, district_env, hospitals, district_hospital_aggregates,
# knowledge_articles, community_reports, and satellite_extents on startup. Make sure
# the data/ directory (xlsx/csv/geojson source files) is present at either:
#   - backend/data/        (slim backend-only checkout)
#   - <repo-root>/data/    (normal project layout)
# See backend/DEPLOY_REFERENCE_DATA.md for the full list and re-seed instructions.

# --- Model 4B U-Net (Hugging Face) ---
HF_MODEL_REPO=ripro805/floodshield-ai-models
HF_MODEL_REVISION=
HF_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=ee_service_account.json
# Root .dockerignore for FloodShield Docker builds

# Secrets (must NEVER ship)
.env
.env.*
!.env.example
*.pem
*.key

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
.mypy_cache/
.venv*/

# Test & scratch logs
tests/
*.log
scratch*

# Node / frontend build output
node_modules/
frontend/node_modules/
frontend/.next/
.dist/
.puku/

# VCS / IDE
.git/
.gitignore
.gitkeep
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
